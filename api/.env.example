# ==========================================
#  Configurações do Banco de Dados
# ==========================================
# String de conexão do PostgreSQL (Local ou Nuvem)
# O formato padrão é postgresql://usuario:senha@host:porta/banco_de_dados
DATABASE_URL=postgresql://

# ==========================================
# Autenticação (Better Auth)
# ==========================================
# Segredo utilizado para assinar os tokens (gere um aleatório)
BETTER_AUTH_SECRET=
# URL principal da aplicação API
BETTER_AUTH_URL=http://localhost:3333

# ==========================================
# Segurança e Criptografia
# ==========================================
# Chave de criptografia de 32 bytes para dados sensíveis
ENCRYPTION_KEY=

# ==========================================
# E-mail (Resend)
# ==========================================
# Chave de API do serviço de emails Resend
RESEND=

# ==========================================
# Armazenamento e CDN (Cloudflare R2)
# ==========================================
# ID da sua conta Cloudflare (Encontrado no Dashboard > Canto superior direito)
R2_ACCOUNT_ID=
# Token da API com permissões "Admin Read & Write"
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nome exato do Bucket criado
R2_BUCKET_NAME=
# Domínio Público configurado (Opcional, mas recomendado para produção)
# Exemplo: https://cdn.seudominio.com
R2_PUBLIC_DOMAIN=
