{
  "name": "buni",
  "version": "1.0",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun --watch --env-file=.env.development src/index.ts",
    "db:generate": "bun --env-file .env.development --bun drizzle-kit generate",
    "db:migrate": "bun --env-file .env.development --bun drizzle-kit migrate",
    "db:push": "bun --env-file .env.development --bun drizzle-kit push",
    "db:reset": "bun --env-file .env.development src/database/reset.ts",
    "db:studio": "bun --env-file .env.development --bun drizzle-kit studio",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.13",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.4.17",
    "drizzle-orm": "^0.45.1",
    "drizzle-seed": "^0.3.1",
    "elysia": "1.4.22",
    "pg": "^8.17.2",
    "resend": "^6.9.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.8.3"
  },
  "module": "src/index.js"
}