# ==========================================
# Configurações de API e Conexão (Variáveis expostas ao browser)
# Obs: Todas as variáveis que o frontend deve acessar precisam do prefixo VITE_
# ==========================================

# URL base da sua API Backend (onde o servidor Bun/Elysia está rodando)
# Em produção, mudar para o domínio da sua API (ex: https://api.seudominio.com)
VITE_PUBLIC_API_URL=http://localhost:3333

# URL base do Frontend (usado por algumas bibliotecas de autenticação para redirects)
# Em produção, mudar para o domínio do seu frontend (ex: https://seudominio.com)
VITE_BETTER_AUTH_URL=http://localhost:5173
