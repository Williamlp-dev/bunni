{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "buni-media-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "bunni-media",
			"preview_bucket_name": "bunni-media"
		}
	]
}